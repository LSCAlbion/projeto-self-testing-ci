# Configurações da Aplicação
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0

# Banco de Dados (SQLite por padrão)
DATABASE_URL=sqlite:///./wallet.db

# Gateway Externo Fictício (Anti-Fraude e Notificações)
ANTI_FRAUD_SERVICE_URL=https://api.gateway-antifraude-ficticio.local/v1/notify
ANTI_FRAUD_TIMEOUT_SECONDS=3.0

# Serviços Externos de Validação Cadastral / Câmbio (Stubs)
KYC_VALIDATION_SERVICE_URL=https://api.kyc-service.local/v1/validate
EXCHANGE_RATE_SERVICE_URL=https://api.cambio-service.local/v1/rates
